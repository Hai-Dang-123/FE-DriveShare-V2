{
  "cli": {
    "version": ">= 16.26.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "GOOGLE_SERVICES_JSON_BASE64": "$GOOGLE_SERVICES_JSON"
      },
      "android": {
        "prebuildCommand": "node scripts/eas-build-pre-install.js"
      }
    },
    "development-client": {
      "extends": "development",
      "android": {
        "buildType": "apk",
        "prebuildCommand": "node scripts/eas-build-pre-install.js"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "GOOGLE_SERVICES_JSON_BASE64": "$GOOGLE_SERVICES_JSON"
      },
      "android": {
        "prebuildCommand": "node scripts/eas-build-pre-install.js"
      }
    },
    "preview-apk": {
      "extends": "preview",
      "android": {
        "buildType": "apk",
        "prebuildCommand": "node scripts/eas-build-pre-install.js"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "GOOGLE_SERVICES_JSON_BASE64": "$GOOGLE_SERVICES_JSON"
      },
      "android": {
        "buildType": "apk",
        "prebuildCommand": "node scripts/eas-build-pre-install.js"
      }
    }
  },
  "submit": {
    "production": {}
  }
}